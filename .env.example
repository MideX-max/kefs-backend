# Database Configuration
# Local MongoDB:
#   MONGODB_URI=mongodb://127.0.0.1:27017/kas
# MongoDB Atlas: use the SRV connection string from
# Database > Connect > Drivers, and make sure your deployment's Network Access
# list allows the host you deploy from:
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kas?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/kas
# Optional: overrides the database named in MONGODB_URI
# MONGODB_DB_NAME=kas
DB_POOL_SIZE=10
MONGODB_TIMEOUT_MS=15000

# Cloudinary - the single source of truth for every uploaded image and file.
# Credentials come from the Cloudinary dashboard. The API secret is server-side
# only and must never be exposed to the frontend.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Root folder that owns every asset this app creates; deletes are refused
# outside it.
CLOUDINARY_FOLDER=keffi
# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_MB=10

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=8h

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Manager accounts are seeded from data/seedData.js (INITIAL_MANAGERS) the first
# time the database is empty. Change the passwords there before deploying, or
# rotate them afterwards via PUT /api/auth/settings.

# Environment
NODE_ENV=development
PORT=5000

# Guest Access Password (required)
# Set a strong password for apartment managers to access guest registration
# This is validated on the backend only - never expose to frontend
GUEST_ACCESS_PASSWORD=your_secure_password_here
GUEST_TOKEN_EXPIRES_IN=2h
